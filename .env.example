# NÖBET — çekirdek yığın sırları (ŞABLON)
# Kopyalayın:  cp .env.example .env   ve doldurun.
# .env versiyon kontrolüne GİRMEZ.

# --- PostgreSQL ---
POSTGRES_DB=nobet
POSTGRES_USER=nobet
POSTGRES_PASSWORD=DEGISTIR_GUCLU_PAROLA

# Uygulama rolü (süper kullanıcı DEĞİL, yalnızca DML). Boş bırakmayın.
# ./nobet-app-rolu-ac.sh rolü açar ve bu iki satırı kendisi doldurur.
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# --- Mosquitto ---
# Firmware'deki firmware/include/secrets.h (MQTT_USER / MQTT_PASS) ile
# BİREBİR aynı olmalı.
MQTT_USER=nobet-node
MQTT_PASS=DEGISTIR_GUCLU_PAROLA

# --- API ---
# Üretmek için:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=DEGISTIR
# Ayarlarda saklanan sağlayıcı sırlarını (SMTP, SMS) şifreleyen Fernet anahtarı.
# Üretmek için:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kaybolursa kayıtlı sırlar çözülemez — yedekleyin.
SETTINGS_KEY=

# --- Bildirim ---
# dryrun: mesajlar üretilir ve loglanır ama gönderilmez. whatsapp: wa-gateway üzerinden.
NOTIFY_CHANNEL=dryrun
# wa-gateway ile API arasındaki imza sırrı (JWT_SECRET gibi üretin)
WA_WEBHOOK_SECRET=DEGISTIR
# Anlaşılmayan mesajlarda haber verilecek yönetici numarası (ör. 905xxxxxxxxx). Boş olabilir.
ADMIN_WHATSAPP=
